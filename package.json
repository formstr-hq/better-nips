{
  "name": "better-nips",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "type": "module",
  "description": "A Nostr client for community-authored NIPs (kind 30817), surfaced by following and web-of-trust, with NIP-32 approvals.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && next build && pnpm worker:build",
    "start": "next start",
    "worker:build": "tsup src/worker/run.ts --format esm --platform node --target node22 --out-dir dist-worker --clean",
    "worker:start": "node dist-worker/run.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@formstr/local-relay": "^0.4.2",
    "@formstr/signer": "^0.2.2",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.17.3",
    "ipaddr.js": "^2.2.0",
    "next": "^16.3.0",
    "nostr-tools": "^2.23.5",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
