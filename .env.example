# Host port published by the web container.
APP_PORT=3000

POSTGRES_DB=better_nips
POSTGRES_USER=better_nips
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Use URL-encoded credentials if the password contains reserved URL characters.
DATABASE_URL=postgresql://better_nips:replace-with-a-long-random-password@postgres:5432/better_nips

SITE_URL=http://localhost:3000
MAX_INDEXED_NIPS=10000
NIP_INDEX_CRON=0 3 * * *

# JSON relay registry. ws:// is intended only for local testing.
NOSTR_INDEX_RELAYS=[{"key":"damus","url":"wss://relay.damus.io","exact":true,"discovery":true},{"key":"nos-lol","url":"wss://nos.lol","exact":true,"discovery":true},{"key":"primal","url":"wss://relay.primal.net","exact":true,"discovery":true},{"key":"nostr-band","url":"wss://relay.nostr.band","exact":true,"discovery":true},{"key":"ditto","url":"wss://relay.ditto.pub","exact":true,"discovery":true}]
RELAY_QUERY_TIMEOUT_MS=8000
RELAY_QUERY_RETRIES=2
RELAY_QUERY_CONCURRENCY=8
INDEX_COORDINATE_CONCURRENCY=4
WORKER_CONCURRENCY=4
MAX_PENDING_INDEX_JOBS=1000
LAZY_INDEX_COOLDOWN_MINUTES=1440
